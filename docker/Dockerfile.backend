FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY backend/src/MealPlanner.Api/MealPlanner.Api.csproj backend/src/MealPlanner.Api/
RUN dotnet restore backend/src/MealPlanner.Api/MealPlanner.Api.csproj
COPY backend/src/MealPlanner.Api/ backend/src/MealPlanner.Api/
RUN dotnet publish backend/src/MealPlanner.Api/MealPlanner.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "MealPlanner.Api.dll"]
